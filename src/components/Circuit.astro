---
// Circuit lines in the corners of the dark sections. Decoration only.
// Each cluster has a fixed size and sits in a corner, so no line runs behind the text.
interface Props { top?: boolean; bottom?: boolean }
const { top = true, bottom = true } = Astro.props;
---
{top && (
<svg class="absolute right-0 top-0 -z-10 hidden h-auto w-[min(760px,72vw)] pointer-events-none sm:block" viewBox="0 0 760 170" aria-hidden="true">
  <defs>
    <linearGradient id="traceGrad" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#2DD4BF" /><stop offset="1" stop-color="#8E7BFF" />
    </linearGradient>
  </defs>
  <path class="trace" d="M760 100H580l-36 36H404" /><path class="pulse" d="M760 100H580l-36 36H404" />
  <path class="trace" d="M700 0v40l-36 36H500" /><path class="pulse p2" d="M700 0v40l-36 36H500" />
  <path class="trace" d="M760 140H668l-22 22H590" />
  <path class="trace" d="M446 0v28l-22 22" />
  <g fill="#0A0920" stroke="#2DD4BF" stroke-width="1.5" opacity="0.9">
    <circle cx="404" cy="136" r="4" /><circle cx="500" cy="76" r="4" /><circle cx="590" cy="162" r="4" /><circle cx="424" cy="50" r="4" />
  </g>
</svg>
)}
{bottom && (
  <>
    <svg class="absolute bottom-0 right-0 -z-10 hidden h-[84px] w-[380px] pointer-events-none sm:block" viewBox="0 0 380 84" aria-hidden="true">
      <path class="trace" d="M380 26H262l-30 30H118" /><path class="pulse p3" d="M380 26H262l-30 30H118" />
      <path class="trace" d="M330 84V62" />
      <g fill="#0A0920" stroke="#2DD4BF" stroke-width="1.5" opacity="0.9"><circle cx="118" cy="56" r="4" /><circle cx="330" cy="58" r="4" /></g>
    </svg>
    <svg class="absolute bottom-0 left-0 -z-10 hidden h-[84px] w-[380px] pointer-events-none sm:block" viewBox="0 0 380 84" aria-hidden="true">
      <path class="trace" d="M0 30h112l28 28h118" /><path class="pulse p4" d="M0 30h112l28 28h118" />
      <g fill="#0A0920" stroke="#2DD4BF" stroke-width="1.5" opacity="0.9"><circle cx="258" cy="58" r="4" /></g>
    </svg>
  </>
)}
