---
// Original mark: a head in profile drawn as one line, with circuit traces inside.
interface Props { size?: number; sub?: boolean }
const { size = 36, sub = true } = Astro.props;
const id = 'lg' + Math.random().toString(36).slice(2, 8);
---
<span class="inline-flex items-center gap-3">
  <svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id={id} x1="6" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
        <stop stop-color="#B5A8FF" /><stop offset=".55" stop-color="#6F8DFF" /><stop offset="1" stop-color="#2DD4BF" />
      </linearGradient>
    </defs>
    <path d="M18 44v-6.6C11.500 34.400 7 28.200 7 21 7 11.600 14.600 4 24 4c8.600 0 15.700 6.300 16.800 14.600l3.500 6.800c.4.8-.1 1.800-1 1.900l-2.300.3v5.900c0 2.500-2 4.500-4.500 4.500H33V44" stroke={`url(#${id})`} stroke-width="2.6" />
    <path d="M15 16h7l4 4h5M14 25h8l4 4h4M24 10.500v5.500" stroke="#2DD4BF" stroke-width="1.8" />
    <g fill="#2DD4BF"><circle cx="15" cy="16" r="1.9" /><circle cx="31" cy="20" r="1.9" /><circle cx="14" cy="25" r="1.9" /><circle cx="30" cy="29" r="1.9" /><circle cx="24" cy="10" r="1.9" /></g>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display font-extrabold tracking-[0.2em] text-[1.3rem] grad-text">QUALIA</span>
    {sub && <span class="font-mono text-[0.58rem] tracking-[0.3em] uppercase text-haze mt-1.5">AI Consulting</span>}
  </span>
</span>
