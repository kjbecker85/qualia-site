---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import Circuit from '../components/Circuit.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';

const next = [
  { n: '01', title: 'You write', text: 'Send the form or an email. A few lines about your company are enough.' },
  { n: '02', title: 'We reply', text: 'We answer by email and set a time for a call.' },
  { n: '03', title: 'We talk', text: 'On the call we hear your goals and tell you plainly if we can help.' },
];
---
<Layout title="Contact | Qualia AI Consulting" description="Book a call with Qualia AI Consulting. Send the form or write to support@engagequalia.com.">
  <section id="contact" class="dark-surface grid-lines">
    <Circuit />
    <div class="wrap pt-36 pb-24 sm:pt-44 sm:pb-32">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
        <div>
          <p class="eyebrow text-teal">Contact</p>
          <h1 class="display-2 text-white mt-5" style="font-size:clamp(2.4rem,5.6vw,4.4rem)">Book a call</h1>
          <p class="lead mt-6 text-mist">Tell us about your company and what you want AI to do for it. We will reply by email to set up a call.</p>
          <ul class="mt-10 space-y-5 text-mist">
            <li class="flex items-center gap-4"><span class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-teal"><Icon name="mail" class="w-5 h-5" /></span><a class="text-white hover:underline underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li class="flex items-center gap-4"><span class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-teal"><Icon name="pin" class="w-5 h-5" /></span><span>{SITE.location}</span></li>
            <li class="flex items-center gap-4"><span class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-teal"><Icon name="link" class="w-5 h-5" /></span><a class="text-white hover:underline underline-offset-4" href={SITE.linkedin} target="_blank" rel="noopener">Qualia AI Consulting on LinkedIn</a></li>
          </ul>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="bg-paper dot-grid">
    <div class="wrap py-20 sm:py-28">
      <div class="max-w-2xl reveal">
        <p class="eyebrow text-teal-deep">What happens next</p>
        <h2 class="display-2 text-ink mt-5">Three short steps</h2>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {next.map((s, i) => (
          <div class="card p-8 reveal" style={`--d:${i * 90}ms`}>
            <p class="font-mono text-sm text-violet">{s.n}</p>
            <h3 class="display-3 text-ink mt-6">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-body">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
