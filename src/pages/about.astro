---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactSection from '../components/ContactSection.astro';

const ways = [
  { title: 'Start with the work', text: 'We look at what your people do each day before we talk about tools. The plan follows the work.' },
  { title: 'People first', text: 'A tool helps only when people use it. Training and habits get the same care as software.' },
  { title: 'Build it, then teach it', text: 'We use AI to build our own products. What we teach comes from doing the work ourselves.' },
  { title: 'Plain words', text: 'You get reports and plans that every leader can read. Each new term is explained where it first appears.' },
];
---
<Layout title="About | Qualia AI Consulting" description="Qualia AI Consulting is led by Kyle Becker, a former US Marine based in the Dallas/Fort Worth area. We guide companies through AI workforce transformation.">
  <PageHero eyebrow="About" title="A consulting firm that builds what it teaches." lead="Qualia AI Consulting guides companies through AI workforce transformation. We are based in the Dallas/Fort Worth area of Texas." />

  <section class="bg-paper dot-grid">
    <div class="wrap py-20 sm:py-28">
      <div class="grid grid-cols-1 gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-20">
        <div class="reveal">
          <p class="eyebrow text-teal-deep">Who we are</p>
          <h2 class="display-2 text-ink mt-5">Led by Kyle Becker</h2>
          <div class="mt-7 space-y-5 text-lg leading-relaxed text-body">
            <p>Kyle Becker leads Qualia AI Consulting. He is a former US Marine and lives in the Dallas/Fort Worth area.</p>
            <p>Kyle works with clients directly. He also builds software himself, with AI doing much of the work. Three of those products are live: Qualia Trace, Buy and Build, and Departure: Fitness Quest.</p>
            <p>That matters for clients. The methods we teach your teams are the ones we use every day.</p>
          </div>
          <div class="mt-9 flex flex-col gap-4 sm:flex-row">
            <a href="/#contact" class="btn btn-violet">Book a call <span class="arrow"><Icon name="arrow" class="w-4 h-4" /></span></a>
            <a href="/work" class="btn btn-line">See what we build</a>
          </div>
        </div>
        <dl class="card divide-y divide-line reveal" style="--d:120ms">
          {[
            ['Founder', 'Kyle Becker'],
            ['Service', 'Former US Marine'],
            ['Home base', 'Dallas/Fort Worth, Texas'],
            ['What we do', 'AI strategy, training, tools and agents'],
            ['Products live', 'Qualia Trace, Buy and Build, Departure'],
          ].map(([k, v]) => (
            <div class="flex flex-col gap-1 px-7 py-5">
              <dt class="eyebrow text-muted">{k}</dt>
              <dd class="font-display text-lg font-semibold text-ink">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap py-20 sm:py-28">
      <div class="max-w-2xl reveal">
        <p class="eyebrow text-teal-deep">How we work</p>
        <h2 class="display-2 text-ink mt-5">Four habits we keep on every engagement</h2>
      </div>
      <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {ways.map((w, i) => (
          <div class="card p-8 reveal" style={`--d:${(i % 2) * 90}ms`}>
            <p class="font-mono text-sm text-violet">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display-3 text-ink mt-6">{w.title}</h3>
            <p class="mt-3 leading-relaxed text-body">{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactSection />
</Layout>
