---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactSection from '../components/ContactSection.astro';
import { PRODUCTS } from '../config';
---
<Layout title="Work | Qualia AI Consulting" description="Software built by Qualia AI Consulting: Qualia Trace, Buy and Build, and Departure: Fitness Quest. All three are live.">
  <PageHero eyebrow="What we have built" title="Three products, built by Qualia and live today." lead="We build our own software with AI doing much of the work. It keeps our advice honest: we teach what we use." />

  <section class="bg-paper">
    <div class="wrap space-y-24 py-20 sm:space-y-32 sm:py-28">
      {PRODUCTS.map((p, i) => (
        <article id={p.id} class="grid grid-cols-1 scroll-mt-28 items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <a href={p.url} target="_blank" rel="noopener" data-product={p.name} class={`block reveal ${i % 2 ? 'lg:order-2' : ''}`}>
            <div class="frame">
              <div class="frame-bar"><i></i><i></i><i></i><span class="frame-url">{p.host}</span></div>
              <img src={p.image} alt={`Screen of ${p.name}`} width="1280" height="800" loading={i ? 'lazy' : 'eager'} />
            </div>
          </a>
          <div class="reveal" style="--d:100ms">
            <p class="eyebrow text-teal-deep">{String(i + 1).padStart(2, '0')} / {p.kind}</p>
            <h2 class="display-2 text-ink mt-5" style="font-size:clamp(1.9rem,3.4vw,2.7rem)">{p.name}</h2>
            <p class="lead mt-5 text-body">{p.long}</p>
            <ul class="mt-7 space-y-3.5">
              {p.points.map((pt) => <li class="flex gap-3 text-body"><span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-teal/20 text-teal-deep"><Icon name="check" class="w-4 h-4" /></span>{pt}</li>)}
            </ul>
            <a href={p.url} target="_blank" rel="noopener" data-product={p.name} class="btn btn-line mt-9">{p.linkLabel} <Icon name="out" class="w-4 h-4" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap py-20 sm:py-24">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <h2 class="display-2 text-ink reveal">What this means for a client</h2>
        <div class="space-y-5 text-lg leading-relaxed text-body reveal" style="--d:100ms">
          <p>These products cover three different fields: trade compliance, finance education and fitness. Each one went from an idea to a live product that people can use.</p>
          <p>The tools we build for clients are made the same way. We start from the task, build a working version early, and test it with the people who will use it.</p>
          <a href="/services#tools" class="link-arrow">Custom AI tools and agents <Icon name="arrow" class="w-4 h-4" /></a>
        </div>
      </div>
    </div>
  </section>

  <ContactSection heading="Have a tool in mind?" />
</Layout>
